HOMEPAGE_VAR_SONARR_API_KEY=changeme
HOMEPAGE_VAR_SONARR_4K_API_KEY=changeme
HOMEPAGE_VAR_RADARR_API_KEY=changeme
HOMEPAGE_VAR_RADARR_4K_API_KEY=changeme
HOMEPAGE_VAR_PROWLARR_API_KEY=changeme
HOMEPAGE_VAR_OVERSEERR_API_KEY=changeme
HOMEPAGE_VAR_TAUTULLI_API_KEY=changeme
HOMEPAGE_VAR_QBITTORRENT_USERNAME=changeme
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=changeme

# --- Staged widgets ---------------------------------------------------------
# Each of these enables a currently-commented widget block. Fill the value in
# your real .env, then uncomment the matching block in config/services.yaml
# (or config/widgets.yaml for the UniFi one) to light the widget up.

# UniFi UNAS Pro info widget (config/widgets.yaml).
# Must be a LOCAL UniFi OS account -- Ubiquiti SSO logins with 2FA cannot
# authenticate against the local API.
HOMEPAGE_VAR_UNIFI_USERNAME=
HOMEPAGE_VAR_UNIFI_PASSWORD=

# Nginx Proxy Manager — your NPM admin login.
HOMEPAGE_VAR_NPM_USERNAME=
HOMEPAGE_VAR_NPM_PASSWORD=

# AdGuard Home — admin login. The password is bcrypt-hashed in
# adguard/conf/AdGuardHome.yaml and cannot be recovered from there.
HOMEPAGE_VAR_ADGUARD_USERNAME=
HOMEPAGE_VAR_ADGUARD_PASSWORD=

# Audiobookshelf — Settings -> Users -> (user) -> API Token.
HOMEPAGE_VAR_AUDIOBOOKSHELF_API_KEY=

# Komga — a Komga login (email + password); a non-admin user is enough.
HOMEPAGE_VAR_KOMGA_USERNAME=
HOMEPAGE_VAR_KOMGA_PASSWORD=

# Immich — Account Settings -> API Keys.
HOMEPAGE_VAR_IMMICH_API_KEY=

# Paperless-ngx — user profile page, or Django admin -> Auth Tokens.
HOMEPAGE_VAR_PAPERLESS_API_KEY=
ALERT_EMAIL=you@example.com
