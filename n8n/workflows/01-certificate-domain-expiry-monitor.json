      "id": "classify",
      "name": "Classify & Format Alert",
      "parameters": {
        "jsCode": "const first = $input.first().json;\nconst raw = first.stdout ?? first.data ?? '';\nlet records = [];\ntry { records = JSON.parse(raw); } catch (e) {\n  return [{ json: { message: `\u26a0\ufe0f Certificate/domain monitor could not parse cert_check.sh output: ${e.message}\\nraw: ${String(raw).slice(0,500)}` } }];\n}\nconst flagged = records.filter(r => r.severity && r.severity !== 'OK');\nif (flagged.length === 0) return [];\nconst lines = flagged.map(r => {\n  const emoji = r.severity === 'URGENT' ? '\ud83d\udd34' : r.severity === 'WARNING' ? '\ud83d\udfe0' : r.severity === 'ERROR' ? '\u26a0\ufe0f' : '\ud83d\udfe1';\n  if (r.severity === 'ERROR') return `${emoji} ${r.name} \u2014 ${r.note}`;\n  return `${emoji} [${r.severity}] ${r.name} (${r.type}) expires ${r.expiresOn} \u2014 ${r.daysLeft} days left`;\n});\nreturn [{ json: { message: `**Certificate & Domain Expiry Monitor**\\n${lines.join('\\n')}` } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        440,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
