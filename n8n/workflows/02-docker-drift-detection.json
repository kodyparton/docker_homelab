      "name": "Filter Drifted & Format Alert",
      "parameters": {
        "jsCode": "const first = $input.first().json;\nconst raw = first.stdout ?? first.data ?? '';\nlet records = [];\ntry { records = JSON.parse(raw); } catch (e) {\n  return [{ json: { message: `\u26a0\ufe0f Drift detection could not parse drift_check.sh output: ${e.message}\\nraw: ${String(raw).slice(0,500)}` } }];\n}\nconst drifted = records.filter(r => r.drift);\nif (drifted.length === 0) return [];\nconst lines = drifted.map(r => `\ud83d\udd34 ${r.service} (${r.dir}) \u2014 ${r.reason}: expected \\`${r.expectedImage}\\`, container status \\`${r.containerStatus}\\`, running image \\`${r.actualImage || 'n/a'}\\``);\nreturn [{ json: { message: `**Docker Drift Detection**\\n${lines.join('\\n')}` } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        440,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
