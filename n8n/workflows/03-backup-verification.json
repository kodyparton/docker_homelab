    {
      "id": "classify",
      "name": "Filter Failures & Format Alert",
      "parameters": {
        "jsCode": "const first = $input.first().json;\nconst raw = first.stdout ?? first.data ?? '';\nlet records = [];\ntry { records = JSON.parse(raw); } catch (e) {\n  return [{ json: { message: `\u26a0\ufe0f Backup verification could not parse backup_check.sh output: ${e.message}\\nraw: ${String(raw).slice(0,500)}` } }];\n}\nconst failed = records.filter(r => r.status !== 'ok');\nif (failed.length === 0) return [];\nconst lines = failed.map(r => {\n  if (r.status === 'missing') return `\ud83d\udd34 ${r.service} \u2014 no backup file found at all`;\n  const bits = [];\n  if (!r.integrityOk) bits.push('failed integrity check');\n  if (r.stale) bits.push(`stale (${r.ageDays}d old, threshold ${r.staleThresholdDays}d)`);\n  return `\ud83d\udfe0 ${r.service} \u2014 ${bits.join(', ')} (${r.file})`;\n});\nreturn [{ json: { message: `**Backup Verification \u2014 failures found**\\n${lines.join('\\n')}` } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        440,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
