    {
      "id": "4f941b77-f705-4a0f-8d95-1e354722c745",
      "name": "Score, Filter & Dedupe",
      "parameters": {
        "jsCode": "const response = $('Search Adzuna NL').first().json;\nconst results = response.results || [];\nconst weights = JSON.parse($('Search Config').first().json.keywordWeights);\n\n// existing Notion rows: with Simplify on, each property is keyed by its exact\n// Notion column name -- this assumes the URL column is literally named \"URL\"\nconst existingUrls = new Set(\n  $input.all().map(i => i.json.URL).filter(Boolean)\n);\n\nconst MIN_SCORE = 3;\n\nfunction score(text) {\n  const lower = (text || '').toLowerCase();\n  return weights.reduce((sum, w) => sum + (lower.includes(w.keyword.toLowerCase()) ? w.weight : 0), 0);\n}\n\nreturn results\n  .filter(job => !existingUrls.has(job.redirect_url))\n  .map(job => {\n    const text = `${job.title} ${job.description || ''}`;\n    return {\n      json: {\n        title: job.title,\n        company: (job.company && job.company.display_name) || '',\n        location: (job.location && job.location.display_name) || '',\n        url: job.redirect_url,\n        created: job.created,\n        score: score(text),\n      }\n    };\n  })\n  .filter(job => job.score >= MIN_SCORE);"
      },
      "position": [
        880,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
