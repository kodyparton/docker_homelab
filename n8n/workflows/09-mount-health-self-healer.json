        "jsCode": "const lines = $input.all().map(i => i.json.line);\nconst header = 'This is the known OrbStack/SMB-passthrough mount issue \u2014 the container\\'s bind-mounted NAS share dropped and got restarted automatically.';\nreturn [{ json: { message: `**\ud83e\ude7a Mount Health Self-Healer**\\n${lines.join('\\n')}\\n\\n_${header}_` } }];\n",
        "mode": "runOnceForAllItems"
      },
