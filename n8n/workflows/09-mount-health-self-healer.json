    {
      "id": "filter_unhealthy",
      "name": "Filter Unhealthy",
      "parameters": {
        "jsCode": "const first = $input.first().json;\nconst raw = first.stdout ?? first.data ?? '';\nlet records = [];\ntry { records = JSON.parse(raw); } catch (e) {\n  return [{ json: { container: null, alertOnly: true, line: `Mount health check produced unparseable output: ${e.message}` } }];\n}\nconst bad = records.filter(r => r.ok === false);\nreturn bad.map(r => ({ json: {\n  container: r.container,\n  path: r.path,\n  status: r.status,\n  line: `\ud83d\udd27 **${r.container}** \u2014 mount \\`${r.path}\\` is ${r.status === 'container_missing' ? 'missing entirely (no container found)' : 'inaccessible (ENOENT)'}. ${r.status === 'container_missing' ? 'Not restarting (nothing to restart).' : 'Auto-restarting container.'}`\n} }));\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        440,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "credentials": {
        "sshPassword": {
          "id": "E8Y36aEflXOSkIVX",
          "name": "Mac Mini SSH"
        }
      },
      "id": "restart_container",
      "name": "Restart Unhealthy Container",
      "parameters": {
        "command": "={{ $json.status === 'container_missing' ? 'true' : 'docker restart ' + $json.container }}"
      },
      "position": [
        660,
        -100
