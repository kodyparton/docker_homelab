      "name": "Format Discord Message",
      "parameters": {
        "jsCode": "const lines = $input.all().map(i => `\u26c8\ufe0f **${i.json.event}** (${i.json.severity}) \u2014 ${i.json.headline}\\nExpires: ${i.json.expires}`);\nreturn [{ json: { message: `**Storm Watch Snapshot**\\nA local git commit of the homelab config was taken as a precaution (not pushed \u2014 push it yourself with \\`git push\\` if you want it off-box before the storm hits).\\n\\n${lines.join('\\n\\n')}` } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
