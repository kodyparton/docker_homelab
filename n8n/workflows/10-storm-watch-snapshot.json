    {
      "id": "filter_new_severe",
      "name": "Filter New Severe Alerts",
      "parameters": {
        "jsCode": "const staticData = this.getWorkflowStaticData('node');\nif (!staticData.seenAlertIds) staticData.seenAlertIds = [];\nconst body = $input.first().json;\nconst features = body.features || [];\nconst severe = features.filter(f => ['Severe','Extreme'].includes(f.properties.severity));\nconst fresh = severe.filter(f => !staticData.seenAlertIds.includes(f.properties.id));\nfor (const f of fresh) {\n  staticData.seenAlertIds.push(f.properties.id);\n}\nif (staticData.seenAlertIds.length > 200) {\n  staticData.seenAlertIds = staticData.seenAlertIds.slice(-200);\n}\nreturn fresh.map(f => ({ json: {\n  id: f.properties.id,\n  event: f.properties.event,\n  severity: f.properties.severity,\n  headline: f.properties.headline,\n  expires: f.properties.expires\n} }));\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        660,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
