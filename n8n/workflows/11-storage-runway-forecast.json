    {
      "id": "forecast",
      "name": "Project Runway",
      "parameters": {
        "jsCode": "const first = $input.first().json;\nconst raw = (first.stdout ?? first.data ?? '').trim();\nconst points = raw.split('\\n').filter(Boolean).map(line => {\n  const [ts, bytes] = line.split(',').map(Number);\n  return { ts, bytes };\n});\nif (points.length < 5) {\n  return [{ json: { skip: true, reason: `Only ${points.length} data points so far, need at least 5.` } }];\n}\nconst n = points.length;\nconst sumX = points.reduce((s,p) => s + p.ts, 0);\nconst sumY = points.reduce((s,p) => s + p.bytes, 0);\nconst meanX = sumX / n, meanY = sumY / n;\nlet num = 0, den = 0;\nfor (const p of points) {\n  num += (p.ts - meanX) * (p.bytes - meanY);\n  den += (p.ts - meanX) ** 2;\n}\nconst slope = den === 0 ? 0 : num / den; // bytes per second\nconst intercept = meanY - slope * meanX;\nconst latest = points[points.length - 1];\nconst latestGB = (latest.bytes / (1024**3)).toFixed(1);\nif (slope >= 0) {\n  return [{ json: { skip: true, reason: `Free space isn't trending down (slope ${slope.toFixed(2)} B/s). Currently ${latestGB} GB free.` } }];\n}\n// time when bytes = 0: 0 = slope*t + intercept => t = -intercept/slope\nconst zeroT = -intercept / slope;\nconst secondsRemaining = zeroT - latest.ts;\nconst daysRemaining = secondsRemaining / 86400;\nreturn [{ json: { skip: false, daysRemaining: Math.round(daysRemaining * 10) / 10, latestGB } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        440,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
