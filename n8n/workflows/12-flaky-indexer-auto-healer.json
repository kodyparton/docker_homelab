      "name": "Get Full Indexer Config",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "url": "=http://192.168.178.69:9696/api/v1/indexer/{{$json.indexerId}}"
      },
      "position": [
        660,
