    {
      "id": "format_message",
      "name": "Format Discord Message",
      "parameters": {
        "jsCode": "const lines = $input.all().map(i => `\ud83d\udeab **${i.json.indexerName}** disabled \u2014 ${i.json.failureRate}% failure rate over the last ${i.json.deltaQueries} queries (${i.json.deltaFailed} failed). Re-enable manually in Prowlarr once you've confirmed it's healthy again.`);\nreturn [{ json: { message: `**Flaky Indexer Auto-Healer**\\n${lines.join('\\n')}` } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        660,
