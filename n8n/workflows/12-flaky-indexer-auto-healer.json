    {
      "id": "compute_deltas",
      "name": "Compute Deltas & Flag",
      "parameters": {
        "jsCode": "const staticData = this.getWorkflowStaticData('node');\nif (!staticData.previous) staticData.previous = {};\nconst body = $input.first().json;\nconst indexers = body.indexers || [];\nconst flagged = [];\nfor (const ix of indexers) {\n  const prev = staticData.previous[ix.indexerId];\n  staticData.previous[ix.indexerId] = { numberOfQueries: ix.numberOfQueries, numberOfFailedQueries: ix.numberOfFailedQueries };\n  if (!prev) continue; // first run for this indexer, nothing to compare yet\n  const deltaQueries = ix.numberOfQueries - prev.numberOfQueries;\n  const deltaFailed = ix.numberOfFailedQueries - prev.numberOfFailedQueries;\n  if (deltaQueries < 5) continue; // not enough activity this interval\n  const failureRate = deltaFailed / deltaQueries;\n  if (failureRate > 0.5) {\n    flagged.push({ indexerId: ix.indexerId, indexerName: ix.indexerName, deltaQueries, deltaFailed, failureRate: Math.round(failureRate * 100) });\n  }\n}\nreturn flagged.map(f => ({ json: f }));\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        440,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "credentials": {
        "httpHeaderAuth": {
          "id": "k0yCt1S31jaeFHIp",
          "name": "Prowlarr API Key"
        }
      },
