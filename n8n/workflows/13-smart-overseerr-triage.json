      "id": "cfe4d946-a198-410c-91c7-bf5255ae0a6c",
      "name": "Extract Request Info",
      "parameters": {
        "jsChode": "",
        "jsCode": "\nconst body = $input.first().json;\n\nconst tmdbId = body?.media?.tmdbId ?? body?.tmdbId ?? body?.media?.tmdbId2 ?? null;\nconst mediaTypeRaw = body?.media?.media_type ?? body?.media?.mediaType ?? body?.mediaType ?? 'movie';\nconst mediaType = String(mediaTypeRaw).toLowerCase().includes('tv') ? 'tv' : 'movie';\nconst requestId = body?.request?.request_id ?? body?.request?.id ?? body?.requestId ?? body?.request_id ?? null;\nconst title = body?.subject ?? body?.media?.title ?? body?.request?.title ?? 'Unknown title';\n\nconst subs = $('Streaming Subscriptions').first().json.subscriptions;\n\nreturn [{\n  json: { tmdbId, mediaType, requestId, title, subscriptions: subs }\n}];\n"
      },
      "position": [
        440,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "ffed81c7-6ec8-47be-98d5-5583cf47dc8b",
