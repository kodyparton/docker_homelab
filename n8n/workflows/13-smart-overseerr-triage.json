    {
      "id": "890cb9ff-aa58-4b0f-8ede-9e6dbc61881e",
      "name": "Check Subscription Match",
      "parameters": {
        "jsCode": "\nconst ctx = $('Extract Request Info').first().json;\nconst providersResp = $input.first().json;\n\nconst flatrate = providersResp?.results?.US?.flatrate ?? [];\nconst subs = (ctx.subscriptions || []).map(s => String(s).toLowerCase());\n\nlet matchedProvider = null;\nfor (const p of flatrate) {\n  const name = String(p.provider_name || '').toLowerCase();\n  if (subs.some(s => name.includes(s) || s.includes(name))) {\n    matchedProvider = p.provider_name;\n    break;\n  }\n}\n\nreturn [{\n  json: {\n    ...ctx,\n    alreadyAvailable: !!matchedProvider,\n    matchedProvider\n  }\n}];\n"
      },
      "position": [
        880,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
