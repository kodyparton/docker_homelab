    {
      "id": "b10bdbd1-7f72-4c75-9429-8e6b201851fa",
      "name": "Build Digest",
      "parameters": {
        "jsCode": "\nfunction safeLen(nodeName) {\n  try {\n    const d = $(nodeName).first().json;\n    return Array.isArray(d) ? d.length : 'n/a';\n  } catch (e) { return 'n/a'; }\n}\n\nlet tautulliLines = [];\ntry {\n  const stats = $('Tautulli Home Stats').first().json.response.data;\n  const topMovies = stats.find(s => s.stat_id === 'top_movies');\n  const topTv = stats.find(s => s.stat_id === 'top_tv');\n  if (topMovies && topMovies.rows && topMovies.rows.length) {\n    tautulliLines.push('\ud83c\udfac Top movie: ' + topMovies.rows[0].title + ' (' + topMovies.rows[0].total_plays + ' plays)');\n  }\n  if (topTv && topTv.rows && topTv.rows.length) {\n    tautulliLines.push('\ud83d\udcfa Top show: ' + topTv.rows[0].title + ' (' + topTv.rows[0].total_plays + ' plays)');\n  }\n} catch (e) {\n  tautulliLines.push('(no Tautulli watch activity this week)');\n}\n\nlet qbitLine = 'qBittorrent: not authenticated (set the real password in the \"qBittorrent Login\" node)';\ntry {\n  const cookieInfo = $('Extract Session Cookie').first().json;\n  if (cookieInfo.loginOk) {\n    const info = $('qBittorrent Transfer Info').first().json;\n    const gb = (n) => (n / 1024 / 1024 / 1024).toFixed(1);\n    qbitLine = `qBittorrent this session \u2014 \u2b07 ${gb(info.dl_info_data)} GB / \u2b06 ${gb(info.up_info_data)} GB`;\n  }\n} catch (e) {}\n\nconst lines = [\n  '\ud83d\udcca **Weekly Media Server Digest**',\n  '',\n  `Library sizes \u2014 Sonarr: ${safeLen('Sonarr Series Count')} series | Sonarr 4K: ${safeLen('Sonarr 4K Series Count')} series | Radarr: ${safeLen('Radarr Movie Count')} movies | Radarr 4K: ${safeLen('Radarr 4K Movie Count')} movies`,\n  '',\n  ...tautulliLines,\n  '',\n  qbitLine\n];\n\nreturn [{ json: { message: lines.join('\\n') } }];\n"
      },
