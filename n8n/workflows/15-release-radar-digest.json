    {
      "id": "e357749c-a89b-4f8e-9294-988e5208151c",
      "name": "Build Digest",
      "parameters": {
        "jsCode": "\nfunction fmtEpisodes(nodeName) {\n  const items = $(nodeName).first().json;\n  if (!Array.isArray(items) || items.length === 0) return [];\n  return items\n    .sort((a, b) => new Date(a.airDateUtc) - new Date(b.airDateUtc))\n    .map(e => `  \u2022 ${e.series?.title || 'Unknown'} S${String(e.seasonNumber).padStart(2,'0')}E${String(e.episodeNumber).padStart(2,'0')} \u2014 ${e.airDate}`);\n}\n\nfunction fmtMovies(nodeName) {\n  const items = $(nodeName).first().json;\n  if (!Array.isArray(items) || items.length === 0) return [];\n  return items.map(m => {\n    const date = m.digitalRelease || m.physicalRelease || m.inCinemas || 'TBD';\n    return `  \u2022 ${m.title} \u2014 ${String(date).slice(0,10)}`;\n  });\n}\n\nconst sections = [\n  ['\ud83d\udcfa TV', fmtEpisodes('Sonarr Calendar')],\n  ['\ud83d\udcfa TV (4K)', fmtEpisodes('Sonarr 4K Calendar')],\n  ['\ud83c\udfac Movies', fmtMovies('Radarr Calendar')],\n  ['\ud83c\udfac Movies (4K)', fmtMovies('Radarr 4K Calendar')],\n];\n\nlet lines = ['\ud83d\uddd3\ufe0f **Release Radar \u2014 this week**', ''];\nlet anything = false;\nfor (const [label, rows] of sections) {\n  if (rows.length) {\n    anything = true;\n    lines.push(label + ':');\n    lines.push(...rows);\n    lines.push('');\n  }\n}\nif (!anything) {\n  lines.push('Nothing scheduled this week.');\n}\n\nreturn [{ json: { message: lines.join('\\n') } }];\n"
      },
