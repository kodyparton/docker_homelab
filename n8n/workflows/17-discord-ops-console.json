        "jsCode": "const staticData = this.getWorkflowStaticData('node');\nconst base = 'https://discord.com/api/v10/channels/YOUR_DISCORD_CHANNEL_ID/messages?limit=10';\nconst url = staticData.lastMessageId ? `${base}&after=${staticData.lastMessageId}` : base;\nreturn [{ json: { url } }];\n",
