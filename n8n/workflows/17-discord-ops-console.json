    {
      "id": "filter_status_cmd",
      "name": "Filter !status Commands",
      "parameters": {
        "jsCode": "const staticData = this.getWorkflowStaticData('node');\nconst messages = $input.first().json || [];\nconst list = Array.isArray(messages) ? messages : [];\n\nlet maxId = staticData.lastMessageId ? BigInt(staticData.lastMessageId) : 0n;\nfor (const m of list) {\n  const idBig = BigInt(m.id);\n  if (idBig > maxId) maxId = idBig;\n}\nif (maxId > 0n) staticData.lastMessageId = maxId.toString();\n\nconst matches = list.filter(m => !m.author?.bot && typeof m.content === 'string' && m.content.trim().toLowerCase().startsWith('!status'));\nif (matches.length === 0) return [];\nreturn [{ json: { count: matches.length } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        660,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
