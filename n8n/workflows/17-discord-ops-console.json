      "id": "format_status",
      "name": "Format Status Reply",
      "parameters": {
        "jsCode": "const dockerRaw = $('docker ps').first().json.stdout ?? $('docker ps').first().json.data ?? '';\nconst fence = String.fromCharCode(96,96,96);\n\nfunction up(nodeName) {\n  try {\n    const j = $(nodeName).first().json;\n    return !j.error && !j.errorMessage;\n  } catch (e) {\n    return false;\n  }\n}\n\nconst ollamaOk = up('Check Ollama');\nconst qdrantOk = up('Check Qdrant');\nconst whisperOk = up('Check Whisper');\nconst vikunjaOk = up('Check Vikunja');\nconst brainBotOk = /brain-bot:\\s*Up/i.test(dockerRaw);\n\nconst allOk = ollamaOk && qdrantOk && whisperOk && brainBotOk && vikunjaOk;\nconst brainLine = allOk\n  ? '**Second Brain:** \u2705 all systems normal (Ollama, Qdrant, Whisper, Vikunja, brain-bot)'\n  : `**Second Brain:** \u26a0\ufe0f ${[\n      !ollamaOk && 'Ollama unreachable',\n      !qdrantOk && 'Qdrant unreachable',\n      !whisperOk && 'Whisper unreachable',\n      !vikunjaOk && 'Vikunja unreachable',\n      !brainBotOk && 'brain-bot container not Up',\n    ].filter(Boolean).join(', ')}`;\n\nreturn [{ json: { content: `**Homelab Status**\\n${brainLine}\\n${fence}\\n${dockerRaw}\\n${fence}` } }];\n",
        "mode": "runOnceForAllItems"
      },
