      "parameters": {
        "jsCode": "const prompts = [\n  'What went well today?',\n  \"What's one thing you're grateful for right now?\",\n  'What drained your energy today, and what gave you energy?',\n  \"What's on your mind that you haven't said out loud yet?\",\n  'What did you learn today?',\n  'Who did you connect with today?',\n  \"What's one small win worth remembering?\",\n  'What would make tomorrow better than today?'\n];\nconst shuffled = prompts.sort(() => Math.random() - 0.5).slice(0, 3);\nconst message = `**Evening check-in** \\ud83c\\udf19\\n${shuffled.map(p => `- ${p}`).join('\\n')}\\n\\nJust reply here \u2014 I'll fold it into tonight's journal entry.`;\nreturn [{ json: { message, CHANNEL_ID: $input.first().json.CHANNEL_ID } }];\n",
        "mode": "runOnceForAllItems"
      },
