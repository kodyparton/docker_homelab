    {
      "id": "combine",
      "name": "Combine Into Prompt",
      "parameters": {
        "jsCode": "function points(nodeName) {\n  try {\n    const r = $(nodeName).first().json;\n    return (r.result && r.result.points) || [];\n  } catch (e) { return []; }\n}\nfunction strava() {\n  try {\n    const r = $('Get Today\\'s Strava Activities').first().json;\n    return Array.isArray(r) ? r : [];\n  } catch (e) { return []; }\n}\n\nconst convos = points('Get Today\\'s Conversations');\nconst photos = points('Get Today\\'s Photos');\nconst health = points('Get Today\\'s Apple Health');\nconst activities = strava();\n\nconst lines = [];\nif (convos.length) {\n  lines.push('Conversations today:');\n  convos.forEach(p => lines.push('- ' + p.payload.text));\n}\nif (photos.length) {\n  lines.push('Photos shared today:');\n  photos.forEach(p => lines.push('- ' + p.payload.text));\n}\nif (activities.length) {\n  lines.push('Strava activities today:');\n  activities.forEach(a => lines.push(`- ${a.name}: ${a.type}, ${(a.distance/1609.34).toFixed(1)} mi, ${Math.round(a.moving_time/60)} min`));\n}\nif (health.length) {\n  lines.push('Apple Health workouts today:');\n  health.forEach(p => lines.push('- ' + p.payload.text));\n}\n\nconst hasAnything = convos.length || photos.length || activities.length || health.length;\nconst raw = hasAnything ? lines.join('\\n') : '(nothing logged today)';\n\nconst prompt = `Write a short, warm, first-person journal entry for today based on the raw notes below. Write like a person reflecting at the end of their day, not a report. If there's very little material, keep it brief and honest rather than padding it out. Don't invent details that aren't in the notes.\\n\\nToday's raw notes:\\n${raw}\\n\\nJournal entry:`;\n\nreturn [{ json: { prompt, hasAnything, photoCount: photos.length } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        660,
        80
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
