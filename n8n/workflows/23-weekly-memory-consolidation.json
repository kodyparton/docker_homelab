      "name": "Build Summary Prompt",
      "parameters": {
        "jsCode": "const points = $json.result.points;\nconst dates = points.map(p => p.payload.date).sort();\nconst raw = points.map(p => `[${p.payload.date}] ${p.payload.text}`).join('\\n');\nconst prompt = `Summarize the following month-plus-old conversation log into a short, dense paragraph capturing the notable facts, decisions, and events \\u2014 the kind of thing worth remembering long-term. Skip small talk and routine exchanges. Be concise.\\n\\nLog:\\n${raw}\\n\\nSummary:`;\nreturn [{ json: { prompt, ids: points.map(p => p.id), dateFrom: dates[0], dateTo: dates[dates.length-1], count: points.length } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        660,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
