    {
      "id": "build_scan_prompt",
      "name": "Build Scan Prompt",
      "parameters": {
        "jsCode": "const points = $json.result.points;\nconst today = new Date().toISOString().slice(0,10);\nconst facts = points.map((p,i) => `${i+1}. ${p.payload.text}`).join('\\n');\nconst prompt = `Today's date is ${today}. Below is a list of stored facts about Kody. Identify ONLY the ones that reference a date, deadline, or event that is happening today or within the next 3 days. Respond with ONLY a JSON array (no other text) of strings describing what's coming up and why \\u2014 e.g. [\\\"Dentist appointment is today (mentioned March 3rd)\\\"]. If none are relevant, respond with [].\\n\\nFacts:\\n${facts}\\n\\nJSON array:`;\nreturn [{ json: { prompt } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        880,
        100
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "scan_facts",
      "name": "Scan for Upcoming Items",
      "parameters": {
        "jsonBody": "={{ JSON.stringify({ model: \"qwen2.5:7b-instruct\", format: \"json\", stream: false, prompt: $json.prompt }) }}",
        "method": "POST",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "http://192.168.178.69:11434/api/generate"
      },
      "position": [
        1100,
        100
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "parse_reminders",
      "name": "Parse Reminders",
      "parameters": {
        "jsCode": "let items = [];\ntry {\n  const parsed = JSON.parse($json.response);\n  if (Array.isArray(parsed)) {\n    items = parsed.filter(x => typeof x === 'string');\n  } else if (parsed && typeof parsed === 'object') {\n    // model sometimes returns {\"fact\": \"reason\"} instead of an array\n    items = Object.values(parsed).filter(x => typeof x === 'string');\n  }\n} catch (e) { items = []; }\nreturn [{ json: { items, hasItems: items.length > 0, CHANNEL_ID: $('Attach Channel').first().json.CHANNEL_ID } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        1320,
        100
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
