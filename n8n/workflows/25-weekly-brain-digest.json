    {
      "id": "build_digest_prompt",
      "name": "Build Digest Prompt",
      "parameters": {
        "jsCode": "const facts = ($('Get This Week\\'s Facts').first().json.result.points || []).map(p => p.payload.text);\nconst convos = ($json.result.points || []).map(p => p.payload.text);\nconst CHANNEL_ID = $('Attach Channel').first().json.CHANNEL_ID;\n\nif (facts.length === 0 && convos.length === 0) {\n  return [{ json: { skip: true, CHANNEL_ID } }];\n}\n\nconst raw = `New facts this week:\\n${facts.join('\\n') || '(none)'}\\n\\nConversations this week:\\n${convos.join('\\n') || '(none)'}`;\nconst prompt = `Write a short, warm weekly digest titled \\\"What I learned about you this week\\\" summarizing the raw notes below. Group related items naturally, mention what got asked about most if there's a pattern. Keep it to a few sentences \\u2014 this is a quick recap, not an essay. Don't invent anything not in the notes.\\n\\n${raw}\\n\\nDigest:`;\nreturn [{ json: { prompt, skip: false, CHANNEL_ID } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        880,
        100
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
