      "id": "combine",
      "name": "Evaluate Health",
      "parameters": {
        "jsCode": "function up(nodeName) {\n  try {\n    const j = $(nodeName).first().json;\n    return !j.error && !j.errorMessage;\n  } catch (e) {\n    return false;\n  }\n}\n\nconst ollamaOk = up('Check Ollama');\nconst qdrantOk = up('Check Qdrant');\nconst whisperOk = up('Check Whisper');\nconst vikunjaOk = up('Check Vikunja');\n\nlet dockerRaw = '';\ntry {\n  dockerRaw = $('Check Containers').first().json.stdout ?? $('Check Containers').first().json.data ?? '';\n} catch (e) {\n  dockerRaw = '';\n}\nconst brainBotOk = /brain-bot:\\s*Up/i.test(dockerRaw);\nconst ollamaContainerOk = /(^|\\n)ollama:\\s*Up/i.test(dockerRaw);\nconst qdrantContainerOk = /(^|\\n)qdrant:\\s*Up/i.test(dockerRaw);\nconst whisperContainerOk = /(^|\\n)whisper:\\s*Up/i.test(dockerRaw);\n\nconst issues = [];\nif (!ollamaOk) issues.push('Ollama API unreachable (http://192.168.178.69:11434)');\nif (!qdrantOk) issues.push('Qdrant API unreachable (http://192.168.178.69:6333)');\nif (!whisperOk) issues.push('Whisper API unreachable (http://192.168.178.69:9000)');\nif (!vikunjaOk) issues.push('Vikunja API unreachable (http://192.168.178.69:30037)');\nif (!brainBotOk) issues.push('brain-bot container not reporting Up');\nif (!ollamaContainerOk) issues.push('ollama container not reporting Up');\nif (!qdrantContainerOk) issues.push('qdrant container not reporting Up');\nif (!whisperContainerOk) issues.push('whisper container not reporting Up');\n\nreturn [{\n  json: {\n    all_healthy: issues.length === 0,\n    issues,\n  },\n}];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        520,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
