      "parameters": {
        "jsCode": "const prior = $('Build Marker').first().json.results || [];\nconst test = $('Set Test (chat)').first().json;\nconst resp = $json;\nconst elapsed = Date.now() - test._start;\nconst errored = !!(resp.error || resp.errorMessage);\nconst reply = resp.reply || '';\nconst pass = !errored && reply.trim().length > 0 && elapsed < 240000;\nconst results = prior.concat([{\n  label: test.label, pass, elapsed_ms: elapsed,\n  reply_snippet: reply.slice(0, 120),\n  error: errored ? (resp.error || resp.errorMessage) : null,\n}]);\nreturn [{ json: { results } }];\n",
