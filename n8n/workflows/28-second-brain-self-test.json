      "parameters": {
        "jsCode": "// results are carried forward through item JSON - n8n's task-runner\n// sandbox does not expose $getWorkflowStaticData (fails with\n// 'this.getWorkflowStaticData is not a function').\nconst marker = `SELF-TEST MARKER ${new Date().toISOString()} - safe to ignore`;\nreturn [{ json: { marker, results: [] } }];\n",
