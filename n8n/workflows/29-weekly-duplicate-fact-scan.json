    {
      "id": "collect_pairs",
      "name": "Collect Duplicate Pairs",
      "parameters": {
        "jsCode": "const originals = $('Split Facts').all().map(i => i.json);\nconst results = $input.all().map(i => i.json);\nconst seen = new Set();\nconst pairs = [];\nfor (let idx = 0; idx < originals.length; idx++) {\n  const orig = originals[idx];\n  const matches = (results[idx] && results[idx].result) || [];\n  for (const m of matches) {\n    if (!orig || !m || m.id === orig.id) continue;\n    if (typeof m.score !== 'number' || m.score < 0.92) continue;\n    const aId = orig.id < m.id ? orig.id : m.id;\n    const bId = orig.id < m.id ? m.id : orig.id;\n    const key = `${aId}:${bId}`;\n    if (seen.has(key)) continue;\n    seen.add(key);\n    const aText = aId === orig.id ? (orig.payload && orig.payload.text) : (m.payload && m.payload.text);\n    const bText = bId === orig.id ? (orig.payload && orig.payload.text) : (m.payload && m.payload.text);\n    pairs.push({ aId, aText: aText || '(no text)', bId, bText: bText || '(no text)', score: m.score });\n  }\n}\nreturn [{ json: { pairs, count: pairs.length } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        880,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "has_pairs",
      "name": "Any Duplicates Found?",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{$json.count}}",
              "operator": {
                "operation": "gt",
                "type": "number"
              },
              "rightValue": 0
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          }
        }
      },
      "position": [
        1100,
        0
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
    },
    {
      "id": "format_digest",
      "name": "Format Digest",
      "parameters": {
        "jsCode": "const pairs = $json.pairs || [];\nconst lines = pairs.slice(0, 15).map(p => `- (${Math.round(p.score*100)}% similar) \"${p.aText}\"  <->  \"${p.bText}\"`).join('\\n');\nconst more = pairs.length > 15 ? `\\n...and ${pairs.length - 15} more.` : '';\nreturn [{ json: { message: `**\ud83e\udde0 Possible duplicate facts found (${pairs.length})**\\nThese look similar enough they might be saying the same thing twice, or one might be stale. Nothing was changed automatically \u2014 review and \\`forget\\` whichever one is outdated if needed.\\n${lines}${more}` } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        1320,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
