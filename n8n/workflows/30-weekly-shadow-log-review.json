    {
      "id": "build_digest",
      "name": "Build Digest",
      "parameters": {
        "jsCode": "const points = ($json.result && $json.result.points) || [];\nconst now = Date.now();\nconst weekMs = 7 * 24 * 60 * 60 * 1000;\nconst dayMs = 24 * 60 * 60 * 1000;\nconst recent = points.filter(p => {\n  const ts = p.payload && (p.payload.deleted_at || p.payload.completed_at);\n  if (!ts) return false;\n  return (now - new Date(ts).getTime()) <= weekMs;\n});\nconst stale = points.filter(p => {\n  const ts = p.payload && (p.payload.deleted_at || p.payload.completed_at);\n  if (!ts) return true;\n  return (now - new Date(ts).getTime()) > 90 * dayMs;\n});\nconst lines = recent.map(p => {\n  if (p.payload.action === 'forget') return `- \\uD83D\\uDDD1\\uFE0F forgot: \"${p.payload.text}\"`;\n  if (p.payload.action === 'complete_task') {\n    const t = p.payload.original_task || {};\n    return `- \\u2705 completed task: \"${t.title || '(untitled)'}\"`;\n  }\n  return `- ${p.payload.action}: ${JSON.stringify(p.payload).slice(0,100)}`;\n}).join('\\n');\nreturn [{ json: { recent_count: recent.length, digest_lines: lines, prune_ids: stale.map(p => p.id) } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        440,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
